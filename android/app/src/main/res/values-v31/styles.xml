<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android 12+ draws its own launch splash and ignores @drawable/splash. It is kept
         plain black (invisible icon, no branding image) so the logo, tagline and progress
         bar appear once, together, in the web launch loader (#bbBoot), not twice. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">#0a0a0a</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
    </style>
</resources>
