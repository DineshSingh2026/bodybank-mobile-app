<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android 12+ draws its own launch splash (app icon in the middle) and ignores
         @drawable/splash. The branding image is the one place it allows text: it shows
         "BODYBANK / LIFESTYLE MANAGEMENT" near the bottom. 200x80 dp, drawn at xxxhdpi. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/splash_branding</item>
    </style>
</resources>
