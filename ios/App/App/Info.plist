<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>BodyBank - Lifestyle</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>NSCameraUsageDescription</key>
	<string>BodyBank uses the camera to capture body and pose photos for progress tracking and to photograph meals for nutrition analysis.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>BodyBank lets you choose body, meal, and blood-report photos from your library to track progress and analyze nutrition.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>BodyBank saves your progress and nutrition share cards to your photo library.</string>
	<!-- Both strings are required by the optional "Speak your answer" button on the
	     long-form check-in questions. Recording starts only on an explicit tap and
	     stops when you tap stop; iOS transcribes and returns text, and BodyBank saves
	     only the text you review and confirm. No audio is stored or uploaded. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>BodyBank uses the microphone only when you tap “Speak your answer”, so you can dictate your check-in answers instead of typing them. Recording stops as soon as you tap stop, and no audio is saved or uploaded.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>BodyBank uses speech recognition to turn your spoken check-in answer into text you can review and edit before saving. Only the text you confirm is saved — never the audio.</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<!-- BodyBank uses only HTTPS/TLS provided by iOS, which is exempt. Declaring this
	     here stops App Store Connect asking the export-compliance question on every build. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
